# Copy to .env and fill in.

# --- Data source -----------------------------------------------------------
# Free token: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# Free tier is 10 req/min -> keep >= 6 seconds between requests.
FOOTBALL_DATA_MIN_REQUEST_INTERVAL=6.5

# Competitions to ingest (football-data.org codes), comma-separated.
# PL=Premier League PD=La Liga BL1=Bundesliga SA=Serie A FL1=Ligue 1
# CL=Champions League DED=Eredivisie PPL=Primeira Liga ELC=Championship
TRACKED_COMPETITIONS=PL,PD,BL1,SA,FL1

# --- Depth source: API-Football (match events, statistics, player ratings) ---
# Key: https://dashboard.api-football.com/  (free plan: 100 req/day, 10/min)
DEPTH_ENABLED=true
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_MIN_REQUEST_INTERVAL=6.5
API_FOOTBALL_DAILY_LIMIT=100
# Which tracked competitions to enrich (subset — the free plan realistically
# covers ~one league's latest matchday per day).
DEPTH_COMPETITIONS=PL
# Fixtures enriched per run (~4 API calls each, 7 the first time).
DEPTH_MAX_MATCHES_PER_RUN=6
DEPTH_WINDOW_DAYS=6

# --- Database ------------------------------------------------------------------
# Dev: SQLite file. Prod example:
# DATABASE_URL=postgresql+psycopg://chairscore:chairscore@localhost:5432/chairscore
DATABASE_URL=sqlite:///./chairscore.db

# Run `alembic upgrade head` automatically on startup. Set false in prod if
# migrations run as their own deploy step.
RUN_MIGRATIONS_ON_STARTUP=true

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_SCHEDULER=true
SYNC_ON_STARTUP=false
# Protects POST /api/admin/sync
ADMIN_TOKEN=changeme
